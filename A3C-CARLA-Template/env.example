# Copy to .env and fill in the values for this machine.
#   cp env.example .env

# apptainer | docker | native
CARLA_RUNTIME=native

# Required for apptainer/docker. Ignored for native.
CARLA_CONTAINER_IMAGE=

# CARLA entrypoint. Inside official images this is /home/carla/CarlaUE4.sh
CARLA_BINARY=/home/carla/CarlaUE4.sh

# Host directory that contains CarlaUE4.sh when CARLA_RUNTIME=native
CARLA_PATH=

# Where Python workers connect. localhost is correct for native, apptainer,
# and docker --network host.
CARLA_HOST=localhost

# Optional port grid (train_a3c.py / launcher CLI still override these)
# CARLA_START_PORT=2000
# CARLA_PORT_STEP=100
# CARLA_MAP=Town03

# Weights & Biases (leave empty to disable from the shell side)
WANDB_PROJECT=a3c-carla
WANDB_RUN_NAME=
WANDB_ENTITY=
WANDB_API_KEY=
