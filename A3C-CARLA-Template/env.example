# Copy to .env and fill in the values for this machine.
#   cp env.example .env

# CARLA server image. Both pipelines need it.
#   Docker:    carlasim/carla:0.9.15
#   Apptainer: /path/to/carla_0.9.15.sif
CARLA_CONTAINER_IMAGE=

# CARLA entrypoint inside the image. The official images use this path.
CARLA_BINARY=/home/carla/CarlaUE4.sh

# Optional port grid (train_a3c.py / launcher CLI still override these)
# CARLA_START_PORT=2000
# CARLA_PORT_STEP=5
# CARLA_MAP=Town03

# Apptainer only: run training inside a client image instead of a host
# Python environment. The launcher still runs on the host and needs a host
# Python with carla (VENV).
# CLIENT_CONTAINER_IMAGE=/path/to/client.sif
# CLIENT_PYTHON=python
# VENV=/path/to/venv

# Apptainer only: extra bind mounts. Apptainer reads this variable itself.
# APPTAINER_BIND=/scratch

# Weights & Biases is opt-in. Training stays local unless WANDB_API_KEY is set
# (and wandb is installed: pip install -e ".[wandb]"). --no-wandb still disables.
# WANDB_PROJECT=a3c-carla
# WANDB_RUN_NAME=
# WANDB_ENTITY=
# WANDB_API_KEY=
